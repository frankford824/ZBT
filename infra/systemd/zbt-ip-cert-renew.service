[Unit]
Description=Renew ZBT public IP TLS certificate and reload host Nginx
Wants=network-online.target
After=network-online.target nginx.service

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/opt/zbt-certbot/bin/certbot renew --quiet --deploy-hook "/usr/sbin/nginx -t && /usr/bin/systemctl reload nginx"
