# Copy to .env.production and replace every placeholder before production readiness.
APP_ENV=production

DATABASE_URL=postgres://zbt_app:<replace-with-db-password>@<replace-with-db-host>:5432/zbt?sslmode=require
MIGRATION_DATABASE_URL=postgres://zbt:<replace-with-migration-password>@<replace-with-db-host>:5432/zbt?sslmode=require
REDIS_URL=redis://<replace-with-redis-host>:6379/0
JWT_SECRET=<replace-with-strong-jwt-secret-at-least-16-chars>
JWT_ACCESS_TTL=8h

MINIO_ENDPOINT=https://<replace-with-r2-account-id>.r2.cloudflarestorage.com
MINIO_PUBLIC_ENDPOINT=https://<replace-with-r2-account-id>.r2.cloudflarestorage.com
MINIO_ACCESS_KEY=<replace-with-r2-access-key-id>
MINIO_SECRET_KEY=<replace-with-r2-secret-access-key>
MINIO_USE_SSL=true
MINIO_REGION=auto
MINIO_BUCKET=<replace-with-private-bucket>
MINIO_ENSURE_BUCKET=false

AI_SERVICE_URL=http://ai-service:8000
AI_CALLBACK_URL=http://backend:8080/api/v1/ai/callbacks/tasks
AI_SERVICE_HMAC_SECRET=<replace-with-strong-ai-callback-secret-at-least-16-chars>
AI_CALLBACK_ALLOWED_HOSTS=backend,<replace-with-api-host>
AI_CALLBACK_MAX_RESPONSE_BYTES=65536
AI_TASK_OBJECT_MAX_BYTES=134217728
AI_EXPORT_ATTACHMENT_MAX_BYTES=20971520

MODEL_ROUTING_FILE=./app/config/model_routing.yaml
USE_MOCK_PROVIDERS=false
ALLOW_MOCK_FALLBACK=false
AI_LLM_PROVIDER=openai_compatible_primary
AI_LLM_MODEL=gpt-4o-mini
AI_EMBEDDING_PROVIDER=openai_compatible_primary
AI_EMBEDDING_MODEL=text-embedding-3-large
AI_RERANK_PROVIDER=openai_compatible_primary
AI_RERANK_MODEL=gpt-4o-mini
OPENAI_API_KEY=<replace-with-openai-api-key>
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MAX_RESPONSE_BYTES=8388608

# Cloudflare AI Gateway alternative:
# CLOUDFLARE_ACCOUNT_ID=<replace-with-cloudflare-account-id>
# CLOUDFLARE_API_TOKEN=<replace-with-cloudflare-api-token>
# CLOUDFLARE_AI_GATEWAY_ID=<optional-gateway-id>
# AI_LLM_PROVIDER=cloudflare_ai_gateway
# AI_LLM_MODEL=openai/gpt-4.1
# AI_EMBEDDING_PROVIDER=cloudflare_ai_gateway
# AI_EMBEDDING_MODEL=@cf/baai/bge-large-en-v1.5
# AI_RERANK_PROVIDER=cloudflare_ai_gateway
# AI_RERANK_MODEL=openai/gpt-4.1

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

AI_MODEL_PRICING_JSON={"openai_compatible_primary/*":{"input_per_1m":2,"output_per_1m":8},"cloudflare_ai_gateway/*":{"input_per_1m":2,"output_per_1m":8},"deepseek/*":{"input_per_1m":1,"output_per_1m":2},"dashscope/*":{"input_per_1m":1,"output_per_1m":2}}

OCR_PROVIDER=http_ocr
OCR_HTTP_ENDPOINT=<replace-with-ocr-http-endpoint>
OCR_API_KEY=<replace-with-ocr-api-key-if-required>
OCR_HTTP_TIMEOUT_S=120
OCR_POLL_ENDPOINT=
OCR_POLL_INTERVAL_S=2
OCR_POLL_MAX_ATTEMPTS=30
OCR_MAX_BYTES=20971520
OCR_MAX_RESPONSE_BYTES=8388608

MINERU_HTTP_ENDPOINT=
MINERU_API_KEY=
MINERU_PARSE_MODE=auto
MINERU_HTTP_TIMEOUT_S=120
MINERU_POLL_ENDPOINT=
MINERU_POLL_INTERVAL_S=2
MINERU_POLL_MAX_ATTEMPTS=30

PADDLEOCR_HTTP_ENDPOINT=
PADDLEOCR_API_KEY=
PADDLEOCR_PIPELINE=pp_structurev3
PADDLEOCR_HTTP_TIMEOUT_S=120
PADDLEOCR_POLL_ENDPOINT=
PADDLEOCR_POLL_INTERVAL_S=2
PADDLEOCR_POLL_MAX_ATTEMPTS=30

LIBREOFFICE_PATH=/usr/bin/soffice
BID_EXPORT_TEMPLATE_PATH=
BID_EXPORT_WATERMARK_TEXT=

VITE_API_BASE_URL=/api/v1
