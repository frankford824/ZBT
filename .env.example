DATABASE_URL=postgres://zbt_app:zbt_app@postgres:5432/zbt?sslmode=disable
MIGRATION_DATABASE_URL=postgres://zbt:zbt@postgres:5432/zbt?sslmode=disable
REDIS_URL=redis://redis:6379/0
JWT_SECRET=
JWT_ACCESS_TTL=15m

MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=zbt_minio
MINIO_SECRET_KEY=zbt_minio_secret
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MINIO_BUCKET=zbt-files
MINIO_ENSURE_BUCKET=true

# Cloudflare R2 example:
# MINIO_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# MINIO_PUBLIC_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# MINIO_ACCESS_KEY=<r2_access_key_id>
# MINIO_SECRET_KEY=<r2_secret_access_key>
# MINIO_USE_SSL=true
# MINIO_REGION=auto
# MINIO_BUCKET=zbt-files
# MINIO_ENSURE_BUCKET=false

AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_MAX_BODY_BYTES=100663296
AI_CALLBACK_URL=http://backend:8080/api/v1/ai/callbacks/tasks
AI_SERVICE_HMAC_SECRET=dev-only-zbt-ai-callback-secret
AI_CALLBACK_ALLOWED_HOSTS=backend,localhost,127.0.0.1,host.docker.internal
AI_CALLBACK_MAX_RESPONSE_BYTES=65536
AI_TASK_OBJECT_MAX_BYTES=134217728
AI_EXPORT_ATTACHMENT_MAX_BYTES=20971520

MODEL_ROUTING_FILE=./app/config/model_routing.yaml
USE_MOCK_PROVIDERS=false
ALLOW_MOCK_FALLBACK=true
AI_LLM_PROVIDER=openai_compatible_primary
AI_LLM_MODEL=
AI_EMBEDDING_PROVIDER=openai_compatible_primary
AI_EMBEDDING_MODEL=
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
AI_RERANK_PROVIDER=openai_compatible_primary
AI_RERANK_MODEL=
AI_MODEL_PRICING_JSON={"deepseek/deepseek-chat":{"input_per_1m":1,"output_per_1m":2},"openai_compatible_primary/*":{"input_per_1m":2,"output_per_1m":8}}

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_MAX_RESPONSE_BYTES=8388608

DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

OCR_PROVIDER=
OCR_API_KEY=
OCR_HTTP_ENDPOINT=
